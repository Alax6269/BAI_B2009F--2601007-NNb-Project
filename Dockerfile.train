FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
COPY requirements-train.txt .
RUN pip install --no-cache-dir --default-timeout=120 -v torch torchvision --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir --default-timeout=120 -v -r requirements-train.txt
COPY model.py train.py ./
CMD ["python", "train.py"]